          }
        ],
        "url": "{{skill_admin_base_url}}/planning/skills?language=zh-Hant&download=true",
        "description": ""
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 2xx', function () { pm.expect(pm.response.code).to.be.within(200,299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 下載目前完整英文 Skill",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Travel-Data-Source",
            "value": "{{data_source}}"
          },
          {
            "key": "X-App-Language",
            "value": "{{language}}"
          },
          {
            "key": "X-Skill-Admin-Token",
            "value": "{{vault:sydneybuddy-skill-admin-token}}"
          }
        ],
        "url": "{{skill_admin_base_url}}/planning/skills?language=en&download=true",
        "description": ""
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 2xx', function () { pm.expect(pm.response.code).to.be.within(200,299); });"
            ]
          }
        }
      ]
    }
  ]
}
