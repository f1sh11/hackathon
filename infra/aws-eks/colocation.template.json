{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "storage.k8s.io/v1",
      "kind": "StorageClass",
      "metadata": {
        "name": "sydneybuddy-gp2-encrypted",
        "labels": {
          "app.kubernetes.io/name": "sydneybuddy"
        }
      },
      "provisioner": "ebs.csi.aws.com",
      "parameters": {
        "type": "gp2",
        "encrypted": "true",
        "csi.storage.k8s.io/fstype": "ext4"
      },
      "reclaimPolicy": "Delete",
      "volumeBindingMode": "WaitForFirstConsumer",
      "allowVolumeExpansion": false
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "sydneybuddy-gateway",
        "namespace": "zetaris",
        "labels": {
          "app.kubernetes.io/name": "sydneybuddy"
        }
      },
      "data": {
        "Caddyfile": "{\n    admin off\n    auto_https off\n}\n:8080 {\n    handle /sydneybuddy/healthz {\n        respond \"ok\" 200\n    }\n    handle_path /sydneybuddy/* {\n        route {\n            @localSetup path_regexp setup (?i)^/setup(?:/|$)\n            respond @localSetup 404\n            @authorized header Authorization \"Bearer {$APP_ACCESS_TOKEN}\"\n            reverse_proxy @authorized 127.0.0.1:8787 {\n                header_up Host 127.0.0.1:8787\n            }\n            respond `{\"error\":\"Unauthorized: check the cloud access code\"}` 401\n        }\n    }\n    respond 404\n}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "sydneybuddy",
        "namespace": "zetaris",
        "labels": {
          "app.kubernetes.io/name": "sydneybuddy"
        },
        "annotations": {
          "alb.ingress.kubernetes.io/healthcheck-path": "/sydneybuddy/healthz",
          "alb.ingress.kubernetes.io/success-codes": "200"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "sydneybuddy"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": "gateway"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "sydneybuddy",
        "namespace": "zetaris",
        "labels": {
          "app.kubernetes.io/name": "sydneybuddy"
        }
      },
      "spec": {
        "serviceName": "sydneybuddy",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "sydneybuddy"
          }
        },
        "updateStrategy": {
          "type": "OnDelete"
        },
        "persistentVolumeClaimRetentionPolicy": {
          "whenDeleted": "Retain",
          "whenScaled": "Retain"
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "sydneybuddy"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "fsGroup": 1654,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "nodeSelector": {
              "kubernetes.io/hostname": "ip-10-0-11-101.ap-southeast-2.compute.internal"
            },
            "terminationGracePeriodSeconds": 60,
            "containers": [
              {
                "name": "db",
                "image": "postgres:17",
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "sydneybuddy"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "sydneybuddy"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "sydneybuddy-runtime-env",
                        "key": "POSTGRES_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  }
                ],
                "args": [
                  "-c",
                  "shared_buffers=64MB",
                  "-c",
                  "max_connections=25",
                  "-c",
                  "work_mem=2MB"
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "runAsUser": 999,
                  "runAsGroup": 999
                },
                "volumeMounts": [
                  {
                    "name": "postgres-data",
                    "mountPath": "/var/lib/postgresql/data"
                  },
                  {
                    "name": "db-tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "db-run",
                    "mountPath": "/var/run/postgresql"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "sydneybuddy",
                      "-d",
                      "sydneybuddy"
                    ]
                  },
                  "periodSeconds": 5
                }
              },
              {
                "name": "api",
                "image": "REPLACE_WITH_PRIVATE_IMAGE_DIGEST",
                "imagePullPolicy": "IfNotPresent",
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "sydneybuddy-runtime-env"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "ConnectionStrings__SydneyBuddy",
                    "value": "Host=127.0.0.1;Port=5432;Database=sydneybuddy;Username=sydneybuddy;Password=$(POSTGRES_PASSWORD);Maximum Pool Size=10"
                  },
                  {
                    "name": "SYDNEYBUDDY_DATA",
                    "value": "/var/lib/sydneybuddy"
                  },
                  {
                    "name": "Kestrel__Endpoints__Http__Url",
                    "value": "http://127.0.0.1:8787"
                  },
                  {
                    "name": "DOTNET_PROCESSOR_COUNT",
                    "value": "1"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsUser": 1654,
                  "runAsGroup": 1654,
                  "runAsNonRoot": true
                },
                "resources": {
                  "requests": {
                    "cpu": "200m",
                    "memory": "1Gi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1536Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "app-state",
                    "mountPath": "/var/lib/sydneybuddy"
                  },
                  {
                    "name": "runtime-files",
                    "mountPath": "/var/lib/sydneybuddy/.secrets.json",
                    "subPath": ".secrets.json",
                    "readOnly": true
                  },
                  {
                    "name": "api-tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "startupProbe": {
                  "exec": {
                    "command": [
                      "node",
                      "/app/infra/oracle/healthcheck.mjs"
                    ]
                  },
                  "failureThreshold": 30,
                  "periodSeconds": 10
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "node",
                      "/app/infra/oracle/healthcheck.mjs"
                    ]
                  },
                  "periodSeconds": 20,
                  "timeoutSeconds": 5
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "node",
                      "/app/infra/oracle/healthcheck.mjs"
                    ]
                  },
                  "periodSeconds": 30,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                }
              },
              {
                "name": "gateway",
                "image": "caddy:2",
                "env": [
                  {
                    "name": "APP_ACCESS_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "sydneybuddy-runtime-env",
                        "key": "APP_ACCESS_TOKEN"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "name": "gateway",
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ],
                    "add": [
                      "NET_BIND_SERVICE"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "runAsUser": 1000,
                  "runAsGroup": 1000
                },
                "volumeMounts": [
                  {
                    "name": "gateway-config",
                    "mountPath": "/etc/caddy/Caddyfile",
                    "subPath": "Caddyfile",
                    "readOnly": true
                  },
                  {
                    "name": "caddy-data",
                    "mountPath": "/data"
                  },
                  {
                    "name": "caddy-config",
                    "mountPath": "/config"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/sydneybuddy/healthz",
                    "port": "gateway"
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "runtime-files",
                "secret": {
                  "secretName": "sydneybuddy-runtime-files",
                  "defaultMode": 288
                }
              },
              {
                "name": "gateway-config",
                "configMap": {
                  "name": "sydneybuddy-gateway"
                }
              },
              {
                "name": "api-tmp",
                "emptyDir": {}
              },
              {
                "name": "db-tmp",
                "emptyDir": {}
              },
              {
                "name": "db-run",
                "emptyDir": {}
              },
              {
                "name": "caddy-data",
                "emptyDir": {}
              },
              {
                "name": "caddy-config",
                "emptyDir": {}
              }
            ]
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "postgres-data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "storageClassName": "sydneybuddy-gp2-encrypted",
              "resources": {
                "requests": {
                  "storage": "5Gi"
                }
              }
            }
          },
          {
            "metadata": {
              "name": "app-state"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "storageClassName": "sydneybuddy-gp2-encrypted",
              "resources": {
                "requests": {
                  "storage": "2Gi"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
