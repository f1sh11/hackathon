# Copy to .env; keep the real file private and outside Git.
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
API_PORT=8787
# Optional provider keys stay on the server. Never put a Zetaris admin login in the mobile app.
NVIDIA_API_KEY=
GOOGLE_SERVER_KEY=
TFNSW_API_KEY=
# Optional cloud Zetaris profile (fill privately after its datasets are ready).
Zetaris__Cloud__Transport=ui-proxy
Zetaris__Cloud__BaseUrl=
Zetaris__Cloud__LoginUrl=
Zetaris__Cloud__Username=
Zetaris__Cloud__Password=
Zetaris__Cloud__SocialEnabled=false
Zetaris__Cloud__RestaurantsEnabled=false
